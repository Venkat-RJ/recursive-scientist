+import { ThreadId } from "@synara/contracts";
+import { useEffect } from "react";
+
+import { embedWorkspaceMatches, readEmbedMode } from "../../embedMode";
+import { useStore } from "../../store";
+import { getThreadFromState } from "../../threadDerivation";
+import { retainThreadDetailSubscription } from "../../threadDetailSubscriptionRetention";
+import type { Thread } from "../../types";
+import { deriveWorkLogEntries, type WorkLogEntry } from "../../workLog";
+
+const RECENT_THREADS = 6;
+const RECENT_EXECUTIONS = 40;
+const OUTPUT_LIMIT = 32768;
+
+function executionRecord(thread: Thread, entry: WorkLogEntry, reveal = false) {
+  const command = entry.rawCommand ?? entry.toolDetails?.command ?? entry.command;
+  if (entry.itemType !== "command_execution" || !entry.toolCallId || !command) return null;
+  const provider =
+    entry.toolDetails?.provider ?? thread.session?.provider ?? thread.modelSelection.provider;
+  // Codex item IDs and Claude tool-use IDs are unique within a conversation.
+  if (provider !== "codex" && provider !== "claudeAgent") return null;
+  const lifecycle = entry.executionStatus ?? entry.toolStatus;
+  if (
+    lifecycle !== "running" &&
+    lifecycle !== "completed" &&
+    lifecycle !== "failed" &&
+    lifecycle !== "cancelled"
+  )
+    return null;
+  const details = entry.toolDetails?.output;
+  const exitCode = details?.exitCode ?? null;
+  const interrupted =
+    (thread.latestTurn?.turnId === entry.turnId && thread.latestTurn?.state === "interrupted") ||
+    thread.activities.some(
+      (activity) => activity.kind === "turn.aborted" && activity.turnId === entry.turnId,
+    );
+  const status =
+    lifecycle === "running" &&
+    (interrupted ||
+      !thread.session ||
+      thread.session.status === "closed" ||
+      thread.session.status === "error" ||
+      thread.session.orchestrationStatus === "stopped" ||
+      thread.session.orchestrationStatus === "interrupted")
+      ? "unknown"
+      : lifecycle;
+  const output = details?.output ?? [details?.stdout, details?.stderr].filter(Boolean).join("\n");
+  return {
+    id: JSON.stringify([thread.id, entry.toolCallId]),
+    threadId: thread.id,
+    turnId: entry.turnId,
+    provider,
+    cwd: entry.toolDetails?.cwd,
+    command: command.slice(0, 4096),
+    output: output.slice(0, OUTPUT_LIMIT),
+    stdout: details?.stdout?.slice(0, OUTPUT_LIMIT),
+    stderr: details?.stderr?.slice(0, OUTPUT_LIMIT),
+    startedAt: entry.liveActivity?.startedAt ?? entry.createdAt,
+    completedAt: lifecycle === "running" ? undefined : entry.liveActivity?.lastActivityAt,
+    status,
+    exitCode,
+    truncated: Boolean(details?.truncated || output.length > OUTPUT_LIMIT),
+    reveal,
+  };
+}
+
+function postExecution(
+  config: NonNullable<ReturnType<typeof readEmbedMode>>,
+  record: NonNullable<ReturnType<typeof executionRecord>>,
+) {
+  if (!config.hostOrigin) return;
+  window.parent.postMessage(
+    {
+      type: "synara:agent-terminal",
+      workspaceRoot: config.workspaceRoot,
+      ...record,
+    },
+    config.hostOrigin,
+  );
+}
+
+export function latticeExecutionAction(threadId: string | null | undefined, entry: WorkLogEntry) {
+  if (!threadId || !entry.toolCallId || entry.itemType !== "command_execution") return undefined;
+  const config = readEmbedMode();
+  if (!config?.hostOrigin || config.surface !== "chrome") return undefined;
+  const state = useStore.getState();
+  const thread = getThreadFromState(state, ThreadId.makeUnsafe(threadId));
+  const project = state.projects.find((candidate) => candidate.id === thread?.projectId);
+  if (!thread || !embedWorkspaceMatches(config, project?.cwd)) return undefined;
+  const record = executionRecord(thread, entry, true);
+  return record ? { record, open: () => postExecution(config, record) } : undefined;
+}
+
+/** Read Synara's durable tool activities, including for recently visited and running chats. */
+export function useLatticeAgentTerminal(enabled: boolean, projectCwd: string | null) {
+  useEffect(() => {
+    const config = enabled ? readEmbedMode() : null;
+    if (
+      !config?.hostOrigin ||
+      config.surface !== "chrome" ||
+      !embedWorkspaceMatches(config, projectCwd)
+    )
+      return;
+    const subscriptions = new Map<ThreadId, () => void>();
+    const sent = new Map<string, string>();
+    const previousThreads = new Map<ThreadId, Thread>();
+    let scheduled = false;
+    let disposed = false;
+    const sync = () => {
+      scheduled = false;
+      if (disposed) return;
+      const state = useStore.getState();
+      const projectIds = new Set(
+        state.projects
+          .filter((project) => embedWorkspaceMatches(config, project.cwd))
+          .map((project) => project.id),
+      );
+      const threads = Object.values(state.threadShellById ?? {})
+        .filter((thread) => projectIds.has(thread.projectId))
+        .sort((a, b) => (b.updatedAt ?? b.createdAt).localeCompare(a.updatedAt ?? a.createdAt));
+      const retain = new Set(threads.slice(0, RECENT_THREADS).map((thread) => thread.id));
+      for (const thread of threads) {
+        if (state.threadSessionById?.[thread.id]?.activeTurnId) retain.add(thread.id);
+      }
+      for (const [id, release] of subscriptions) {
+        if (retain.has(id)) continue;
+        release();
+        subscriptions.delete(id);
+        previousThreads.delete(id);
+      }
+      for (const id of retain) {
+        if (!subscriptions.has(id)) subscriptions.set(id, retainThreadDetailSubscription(id));
+        const thread = getThreadFromState(state, id);
+        if (!thread || previousThreads.get(id) === thread) continue;
+        previousThreads.set(id, thread);
+        const activities = thread.activities.filter(
+          (activity) =>
+            activity.kind === "tool.started" ||
+            activity.kind === "tool.updated" ||
+            activity.kind === "tool.completed",
+        );
+        const visibleTurnIds = new Set(
+          activities.flatMap((activity) => (activity.turnId ? [activity.turnId] : [])),
+        );
+        const entries = deriveWorkLogEntries(activities, undefined, { visibleTurnIds })
+          .filter((entry) => entry.itemType === "command_execution")
+          .slice(-RECENT_EXECUTIONS);
+        for (const entry of entries) {
+          const record = executionRecord(thread, entry);
+          if (!record) continue;
+          const fingerprint = JSON.stringify(record);
+          if (sent.get(record.id) === fingerprint) continue;
+          sent.delete(record.id);
+          sent.set(record.id, fingerprint);
+          postExecution(config, record);
+        }
+      }
+      while (sent.size > RECENT_THREADS * RECENT_EXECUTIONS) {
+        const oldest = sent.keys().next().value;
+        if (oldest === undefined) break;
+        sent.delete(oldest);
+      }
+    };
+    const unsubscribe = useStore.subscribe(() => {
+      if (scheduled) return;
+      scheduled = true;
+      queueMicrotask(sync);
+    });
+    sync();
+    return () => {
+      disposed = true;
+      unsubscribe();
+      for (const release of subscriptions.values()) release();
+    };
+  }, [enabled, projectCwd]);
+}
