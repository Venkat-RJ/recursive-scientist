+async function runWebSearch(request: LatticeComposerPromptRequest, opts: LatticeComposerPromptOptions): Promise<PromptResult> {
+  const config = readEmbedMode();
+  if (!opts.projectId || !config?.hostOrigin || !(await opts.isProviderUsable())) {
+    return { ok: false, error: { code: "no-provider", message: "No search provider is ready." } };
+  }
+  const api = ensureNativeApi();
+  const threadId = ThreadId.makeUnsafe(`lattice-web-search:${request.requestId}`);
+  const createdAt = new Date().toISOString();
+  const { modelSelection, runtimeMode, providerOptions } = opts.turnDispatchSettings;
+  await api.orchestration.dispatchCommand({
+    type: "thread.create", commandId: CommandId.makeUnsafe(crypto.randomUUID()), threadId,
+    projectId: opts.projectId, title: "Web search", modelSelection, runtimeMode,
+    interactionMode: "default", envMode: "local", branch: null, worktreePath: null,
+    createdAt,
+  });
+  await api.orchestration.dispatchCommand({
+    type: "thread.turn.start", commandId: CommandId.makeUnsafe(crypto.randomUUID()), threadId,
+    message: { messageId: MessageId.makeUnsafe(crypto.randomUUID()), role: "user", text: request.text, attachments: [] },
+    modelSelection, runtimeMode, providerOptions, enableComputerControl: false,
+    interactionMode: "default", createdAt,
+  });
+  // Use orchestration directly: the user's selected conversation and composer stay put.
+  const collect = async () => {
+    const deadline = Date.now() + 115_000;
+    try {
+      while (Date.now() < deadline) {
+        await new Promise((resolve) => setTimeout(resolve, 750));
+        const snapshot = await api.orchestration.getThreadDetailSnapshot({ threadId });
+        const thread = snapshot?.thread;
+        if (!thread) continue;
+        if (thread.hasPendingApprovals || thread.hasPendingUserInput) throw new Error("Search needs approval");
+        if (thread.latestTurn?.state === "error" || thread.latestTurn?.state === "interrupted") throw new Error("Search failed");
+        if (thread.latestTurn?.state !== "completed") continue;
+        const answer = thread.messages.findLast((message) => message.role === "assistant");
+        const searched = deriveWorkLogEntries(thread.activities, thread.latestTurn?.turnId).some((entry) => entry.itemType === "web_search");
+        window.parent.postMessage({
+          type: "synara:web-search-result", version: 1, requestId: request.requestId,
+          workspaceRoot: config.workspaceRoot,
+          text: searched && answer ? answer.text.slice(0, 24_000) : '{"error":"web-search-unavailable"}',
+        }, config.hostOrigin!);
+        await api.orchestration.dispatchCommand({ type: "thread.archive", commandId: CommandId.makeUnsafe(crypto.randomUUID()), threadId }).catch(() => undefined);
+        return;
+      }
+      throw new Error("Search timed out");
+    } catch {
+      await api.orchestration.dispatchCommand({ type: "thread.turn.interrupt", commandId: CommandId.makeUnsafe(crypto.randomUUID()), threadId, createdAt: new Date().toISOString() }).catch(() => undefined);
+      postComposerPromptResultToLattice(config, { requestId: request.requestId, ok: false, error: { code: "send-failed", message: "The web search could not finish." } });
+    }
+  };
+  void collect();
+  return { ok: true, outcome: "sent", threadId };
+}
