+/** Presentation only. Keep the original messages for the search relay and provider history. */
+export function displayLatticeWebSearch<T extends { role: string; text: string; streaming?: boolean }>(messages: readonly T[]): T[] {
+  let searchTurn = false;
+  return messages.map((message) => {
+    if (message.role === "user") {
+      searchTurn = /^\[lattice-web-search:[^\]]+\]\n/.test(message.text);
+      if (!searchTurn) return message;
+      const query = message.text.match(/search terms: ("(?:[^"\\]|\\.)*")\./);
+      if (!query) return message;
+      try { return { ...message, text: JSON.parse(query[1]!), textSegments: undefined }; }
+      catch { return message; }
+    }
+    if (!searchTurn || message.role !== "assistant") return message;
+    // Partial JSON is transport data. The native tool activity still shows progress.
+    if (message.streaming) return { ...message, text: "", textSegments: undefined };
+    try {
+      const raw = message.text.trim();
+      const data = JSON.parse(raw.match(/^```(?:json)?\s*([\s\S]*?)\s*```$/i)?.[1] ?? raw);
+      if (!Array.isArray(data.results)) return message;
+      const text = data.results.slice(0, 12).flatMap((hit: { url?: unknown; title?: unknown; description?: unknown }) => {
+        if (typeof hit.url !== "string") return [];
+        let url: URL;
+        try { url = new URL(hit.url); } catch { return []; }
+        if (url.protocol !== "https:" && url.protocol !== "http:") return [];
+        const title = (typeof hit.title === "string" ? hit.title : url.hostname).replace(/[\\[\]<>]/g, "");
+        const description = typeof hit.description === "string" ? hit.description : "";
+        return [`[${title}](<${url.href.replace(/>/g, "%3E")}>)\n\n${description}`];
+      }).join("\n\n");
+      return { ...message, text, textSegments: undefined };
+    } catch { return message; }
+  });
+}
 
